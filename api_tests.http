### Variables
@baseUrl = http://localhost:5197/api
@mangakaEmail = yuki@mangaflow.com
@assistantEmail = kenji@mangaflow.com
@tantouEmail = sakura@mangaflow.com
@password = 123456

# ==============================================================================
# 1. PHÂN HỆ XÁC THỰC (AUTHENTICATION)
# ==============================================================================

### Đăng nhập với vai trò Mangaka
# @name loginMangaka
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{mangakaEmail}}",
  "password": "{{password}}"
}

### Lưu Token Mangaka
@mangakaToken = {{loginMangaka.response.body.token}}


### Đăng nhập với vai trò Tantou (Biên tập viên)
# @name loginTantou
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{tantouEmail}}",
  "password": "{{password}}"
}

### Lưu Token Tantou
@tantouToken = {{loginTantou.response.body.token}}


### Đăng nhập với vai trò Assistant (Trợ lý)
# @name loginAssistant
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{assistantEmail}}",
  "password": "{{password}}"
}

### Lưu Token Assistant
@assistantToken = {{loginAssistant.response.body.token}}

# ==============================================================================
# 2. QUẢN LÝ BỘ TRUYỆN (SERIES) & ĐỀ XUẤT (PROPOSALS)
# ==============================================================================

### Tạo bộ truyện mới (Mangaka) - Trạng thái mặc định là "proposal"
# @name createSeries
POST {{baseUrl}}/series
Authorization: Bearer {{mangakaToken}}
Content-Type: application/json

{
  "title": "Thế Giới Phép Thuật 2026",
  "titleJp": "Magic World 2026",
  "synopsis": "Một câu chuyện giả tưởng kỳ thú về phép thuật cổ xưa.",
  "genres": ["Fantasy", "Adventure"]
}

### Lưu ID Series mới tạo
@seriesId = {{createSeries.response.body.seriesId}}


### Lấy danh sách đề xuất chờ duyệt (Tantou)
# @name getPendingProposals
GET {{baseUrl}}/proposals
Authorization: Bearer {{tantouToken}}

### Lấy ID Proposal mới nhất từ danh sách của bạn và gán vào đây:
@proposalId = {{getPendingProposals.response.body[0].proposalId}}


### Phê duyệt đề xuất truyện mới (Tantou)
# @name approveProposal
PUT {{baseUrl}}/proposals/{{proposalId}}/review
Authorization: Bearer {{tantouToken}}
Content-Type: application/json

{
  "decision": "approved",
  "feedback": "Ý tưởng rất tốt, duyệt chuyển trạng thái sang active!"
}

# ==============================================================================
# 3. QUẢN LÝ CHƯƠNG TRUYỆN (CHAPTERS)
# ==============================================================================

### Tạo chương mới (Mangaka) - Trạng thái mặc định là "draft"
# @name createChapter
POST {{baseUrl}}/series/{{seriesId}}/chapters
Authorization: Bearer {{mangakaToken}}
Content-Type: application/json

{
  "chapterNumber": 1,
  "title": "Chương mở đầu: Sự trỗi dậy của ma pháp",
  "dueDate": "2026-08-30T00:00:00Z"
}

### Lưu ID Chapter mới tạo
@chapterId = {{createChapter.response.body.chapterId}}


### Xem danh sách trang của chương (Mangaka)
# @name getPages
GET {{baseUrl}}/chapters/{{chapterId}}/pages
Authorization: Bearer {{mangakaToken}}

# ==============================================================================
# 4. GIAO NHIỆM VỤ (TASKS) & NỘP BÀI (SUBMISSIONS)
# ==============================================================================

### Lấy danh sách trợ lý hoạt động (Mangaka)
# @name getAssistants
GET {{baseUrl}}/assistants
Authorization: Bearer {{mangakaToken}}

### Lấy ID Trợ lý đầu tiên
@assistantId = {{getAssistants.response.body[0].assistantId}}

### Lưu ID Trang đầu tiên từ danh sách trang của chương (Nếu đã upload trang vẽ)
# (Bạn cần gọi API upload-pages trước hoặc gán ID trang vẽ mẫu từ CSDL vào đây)
@pageId = 00000000-0000-0000-0000-000000000000


### Tạo công việc giao cho trợ lý (Mangaka)
# @name createTask
POST {{baseUrl}}/pages/{{pageId}}/tasks
Authorization: Bearer {{mangakaToken}}
Content-Type: application/json

{
  "title": "Tô màu nền trang 1",
  "description": "Tô màu phối cảnh bầu trời đêm",
  "type": "coloring",
  "assigneeId": "{{assistantId}}",
  "dueDate": "2026-07-30",
  "paymentAmount": 150000
}

### Lưu ID Task mới tạo
@taskId = {{createTask.response.body.taskId}}


### Trợ lý xem danh sách nhiệm vụ được giao (Assistant)
GET {{baseUrl}}/tasks/my-tasks
Authorization: Bearer {{assistantToken}}


### Lấy danh sách bài nộp của công việc (Mangaka)
# @name getSubmissions
GET {{baseUrl}}/tasks/{{taskId}}/submissions
Authorization: Bearer {{mangakaToken}}

### Lưu ID Submission cần duyệt
@submissionId = {{getSubmissions.response.body[0].submissionId}}


### Tác giả duyệt bài nộp trợ lý (Mangaka) -> Tạo bản ghi lương
# @name reviewSubmission
PUT {{baseUrl}}/submissions/{{submissionId}}/review
Authorization: Bearer {{mangakaToken}}
Content-Type: application/json

{
  "decision": "approved",
  "note": "Màu sắc rất đẹp và đúng yêu cầu."
}

# ==============================================================================
# 5. QUẢN LÝ LƯƠNG (PAYROLL) & LỊCH XUẤT BẢN (PUBLISH SCHEDULES)
# ==============================================================================

### Xem bảng lương trợ lý (Mangaka)
# @name getPayroll
GET {{baseUrl}}/payroll
Authorization: Bearer {{mangakaToken}}

### Lấy ID bản ghi lương chờ thanh toán
@payrollId = {{getPayroll.response.body[0].payrollRecordId}}


### Thanh toán lương trợ lý (Mangaka)
PUT {{baseUrl}}/payroll/{{payrollId}}/pay
Authorization: Bearer {{mangakaToken}}


### Tạo lịch xuất bản cho chương truyện (Mangaka)
# @name createSchedule
POST {{baseUrl}}/chapters/{{chapterId}}/schedule
Authorization: Bearer {{mangakaToken}}
Content-Type: application/json

{
  "scheduledDate": "2026-09-01T08:00:00Z"
}

### Lưu ID lịch xuất bản
@scheduleId = {{createSchedule.response.body.scheduleId}}


### BTV duyệt lịch xuất bản (Tantou)
PUT {{baseUrl}}/publish-schedules/{{scheduleId}}/approve
Authorization: Bearer {{tantouToken}}
